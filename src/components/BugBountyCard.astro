---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'bugBounty'>;
}

const { entry } = Astro.props;
const { data } = entry;
const published = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' }).format(data.publishedAt);
const isTechnique = data.kind === 'technique';
const isProcess = data.kind === 'process';
const outcomeClass = (data.outcome ?? 'technique').toLowerCase();
---

<article class="bug-bounty-card">
  <div class="bug-bounty-card-visual" aria-hidden="true">
    <span class="bug-bounty-signal">{data.visualFrom ?? 'SSRF'}</span>
    <span class="bug-bounty-path"><i class="fas fa-arrow-right"></i></span>
    <span class="bug-bounty-signal bug-bounty-signal-internal">{data.visualTo ?? 'INTERNAL'}</span>
    <span class="bug-bounty-card-outcome">{isTechnique ? 'METHOD' : isProcess ? 'PROCESS' : data.outcome}</span>
  </div>
  <div class="bug-bounty-card-body">
    <div class="bug-bounty-card-topline">
      <span class:list={['bug-bounty-outcome', `bug-bounty-outcome-${outcomeClass}`]}>{isTechnique ? 'Educational technique' : data.outcomeDetail}</span>
      <time datetime={data.publishedAt.toISOString()}>{published}</time>
    </div>
    <p class="bug-bounty-category">{data.findingType}</p>
    <h2><a href={`/bug-bounty/${entry.id}/`}>{data.title}</a></h2>
    <p>{data.summary}</p>
    <dl class="bug-bounty-card-facts">
      {isTechnique ? (
        <div><dt>Format</dt><dd>Synthetic example</dd></div>
      ) : isProcess ? (
        <><div><dt>Format</dt><dd>Process case study</dd></div><div><dt>Outcome</dt><dd>Duplicate</dd></div></>
      ) : (
        <><div><dt>Severity</dt><dd>{data.severity}</dd></div><div><dt>Testing</dt><dd>Authorized</dd></div></>
      )}
    </dl>
    <div class="article-tags" aria-label="Finding topics">
      {data.tags.slice(0, 5).map((tag) => <span>{tag}</span>)}
    </div>
    <a class="writeup-read-link" href={`/bug-bounty/${entry.id}/`}>
      {isTechnique ? 'Read the technique' : isProcess ? 'Read the case study' : 'Read the finding'} <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </a>
  </div>
</article>
