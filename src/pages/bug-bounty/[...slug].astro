---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('bugBounty', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'bugBounty'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const canonicalPath = `/bug-bounty/${entry.id}/`;
const site = Astro.site ?? new URL('https://ilias1988.me');
const canonicalUrl = new URL(canonicalPath, site).href;
const published = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' }).format(data.publishedAt);
const tested = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' }).format(data.testedAt);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  description: data.summary,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    '@id': 'https://ilias1988.me/#person',
    name: 'Ilias Georgopoulos',
    url: 'https://ilias1988.me/',
  },
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  keywords: data.tags.join(', '),
  learningResourceType: 'Sanitized vulnerability report',
  isAccessibleForFree: true,
  inLanguage: 'en',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Bug Bounty Research', item: new URL('/bug-bounty/', site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={`${data.title} | Bug Bounty Research | Ilias1988`}
  description={data.summary}
  canonicalPath={canonicalPath}
  currentPath="/bug-bounty/"
  ogType="article"
  image={null}
  twitterCard="summary"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.publishedAt.toISOString()} />
    <meta property="article:modified_time" content={(data.updatedAt ?? data.publishedAt).toISOString()} />
    <meta property="article:author" content="Ilias Georgopoulos" />
    {data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <article class="writeup-article bug-bounty-article">
    <header class="writeup-article-header bug-bounty-article-header">
      <div class="container article-header-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/bug-bounty/">Bug Bounty</a><span>/</span><span>{data.title}</span>
          </nav>
          <p class="terminal-kicker"><span>researcher@authorized-scope:~$</span> inspect {entry.id}</p>
          <h1>{data.title}</h1>
          <p class="article-summary">{data.summary}</p>
          <div class="article-tags" aria-label="Finding topics">
            {data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>

        <dl class="machine-facts bug-bounty-facts">
          <div><dt>Outcome</dt><dd>{data.outcomeDetail}</dd></div>
          <div><dt>Severity</dt><dd>{data.severity}</dd></div>
          <div><dt>Finding type</dt><dd>{data.findingType}</dd></div>
          <div><dt>Testing date</dt><dd>{tested}</dd></div>
          <div><dt>Published</dt><dd>{published}</dd></div>
          <div><dt>Disclosure</dt><dd>Sanitized</dd></div>
        </dl>
      </div>
    </header>

    <div class="container article-shell">
      <aside class="article-sidebar">
        <div class="spoiler-notice bug-bounty-safety-notice">
          <i class="fas fa-user-shield" aria-hidden="true"></i>
          <div>
            <strong>Authorized research</strong>
            <p>This report documents testing performed within an approved bug bounty scope using owned accounts and resources. Target identity and tenant-specific details are withheld.</p>
          </div>
        </div>

        <div class:list={['bug-bounty-validation-state', `bug-bounty-validation-${data.outcome.toLowerCase()}`]}>
          <span>Program outcome</span>
          <strong>{data.outcomeDetail}</strong>
        </div>

        {headings.length > 0 && (
          <nav class="table-of-contents" aria-label="Table of contents">
            <p>On this page</p>
            <ol>
              {headings.filter(({ depth }) => depth === 2).map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <div class="writeup-prose bug-bounty-prose">
        <Content />

        <footer class="article-footer">
          <p><strong>Disclosure note:</strong> this portfolio entry preserves the technical lesson and final triage outcome while withholding the target, domain, report ID, tenant identifiers and any authentication material.</p>
          <div>
            <a href="/bug-bounty/"><i class="fas fa-arrow-left" aria-hidden="true"></i> All bug bounty findings</a>
          </div>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
