---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WriteupLibrary from '../../components/WriteupLibrary.astro';
import WriteupTypeNav from '../../components/WriteupTypeNav.astro';

const writeups = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const counts = {
  all: writeups.length,
  machine: writeups.filter(({ data }) => data.contentType === 'machine').length,
  challenge: writeups.filter(({ data }) => data.contentType === 'challenge').length,
  sherlock: writeups.filter(({ data }) => data.contentType === 'sherlock').length,
};
---

<BaseLayout
  title="Hack The Box Write-ups | Machines, Challenges & Sherlocks"
  description="Practical Hack The Box machine, challenge and Sherlock write-ups covering offensive security, exploitation, DFIR and threat investigation."
  canonicalPath="/writeups/"
  currentPath="/writeups/"
>
  <section class="writeups-hero">
    <div class="container writeups-hero-content">
      <p class="terminal-kicker"><span>root@kali:~$</span> ls ./writeups</p>
      <h1>Hack The Box <span>Write-ups</span></h1>
      <p class="writeups-lead">
        Reproducible attack paths and evidence-led investigations from authorized Hack The Box Machines, Challenges and Sherlocks.
      </p>
      <div class="writeups-status">
        <span><i class="fas fa-book-open" aria-hidden="true"></i> {writeups.length} published</span>
        <span><i class="fas fa-shield-halved" aria-hidden="true"></i> Retired content only</span>
        <a href="/rss.xml"><i class="fas fa-rss" aria-hidden="true"></i> RSS feed</a>
      </div>
    </div>
  </section>

  <div class="writeup-type-nav-wrap">
    <div class="container">
      <WriteupTypeNav current="all" counts={counts} />
    </div>
  </div>

  <WriteupLibrary
    entries={writeups}
    heading="Field notes from the labs"
    description="Browse full machine attack paths, focused technical challenges and defensive Sherlock investigations."
    emptyTitle="The archive is prepared for the first retired entry."
    emptyDescription="New write-ups will appear here after evidence review, content validation and publication through GitHub Pages."
    terminalPath="./writeups"
    showTypeFilter={true}
  />

  <section class="writeup-principles" aria-labelledby="principles-title">
    <div class="container">
      <p class="eyebrow">Publication standard</p>
      <h2 id="principles-title">Built for learning, not spoilers</h2>
      <div class="principles-grid">
        <article>
          <i class="fas fa-check-double" aria-hidden="true"></i>
          <h3>Verified steps</h3>
          <p>Only commands, analysis and findings reproduced during the solve are documented.</p>
        </article>
        <article>
          <i class="fas fa-user-shield" aria-hidden="true"></i>
          <h3>Sanitized evidence</h3>
          <p>Flags, personal secrets, VPN data and unrelated tokens are removed before publication.</p>
        </article>
        <article>
          <i class="fas fa-box-archive" aria-hidden="true"></i>
          <h3>Publishable content</h3>
          <p>Public entries are limited to content permitted by Hack The Box publication rules.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
